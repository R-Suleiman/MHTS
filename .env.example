# npm run db:start generates .env.local with a random local password.
DATABASE_URL=postgresql://mhts:YOUR_PASSWORD@127.0.0.1:5433/mhts
# Set true when served over HTTPS. Keep false for local HTTP, even with npm start.
COOKIE_SECURE=false
# Optional canonical origin behind a proxy, e.g. https://mhts.example.com
# APP_ORIGIN=http://localhost:3000
